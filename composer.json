{
    "name": "xylo-is-coding/coconut-cms",
    "description": "A standalone moddable cms",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "XyloIsCoding\\CoconutCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XyloIsCoding\\CoconutCms\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "XyloIsCoding",
            "email": "xylo.is.coding@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
